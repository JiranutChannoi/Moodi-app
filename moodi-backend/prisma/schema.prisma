generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                     @id(map: "user_pkey") @default(autoincrement()) @map("user_id")
  name                  String                  @db.VarChar(100)
  email                 String                  @unique(map: "user_email_key") @db.VarChar(100)
  passwordHash          String                  @map("password") @db.VarChar(255)
  password_reset_tokens password_reset_tokens[]

  @@map("users")
}

model chatai {
  chat_id   Int       @id @default(autoincrement())
  user_id   Int?
  message   String?
  response  String?
  timestamp DateTime? @default(now()) @db.Timestamp(6)
}

model diaryentries {
  entry_id Int     @id @default(autoincrement())
  user_id  Int?
  mood     String? @db.VarChar(50)
  event    String?
  solution String?
  improve  String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model keywordreplies {
  keyword_id Int     @id @default(autoincrement())
  keyword    String? @unique @db.VarChar(50)
  response   String?
}

model mood {
  mood_id   Int       @id @default(autoincrement())
  user_id   Int?
  mood      String?   @db.VarChar(50)
  note      String?
  timestamp DateTime? @default(now()) @db.Timestamp(6)
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model quizresults {
  quiz_id     Int       @id @default(autoincrement())
  user_id     Int?
  quiz_type   String    @db.VarChar(20) // "PHQ9" | "ST5"
  total_score Int?
  level       String?   @db.VarChar(50)
  timestamp   DateTime? @default(now()) @db.Timestamp(6)
}

model relaxsound {
  sound_id  Int     @id @default(autoincrement())
  title     String? @db.VarChar(100)
  audio_url String? @db.VarChar(255)
}
